# Maintainer: Egor Sozonov
# Contributor: Egor Sozonov

pkgname=projer
pkgver=_
pkgrel=1
pkgdesc='Template-based project generation tool' 
arch=(x86_64)
url='https://github.com/EgorSozonov/$pkgname'
license=(BSD-3-Clause)
depends=() 
makedepends=(git musl)
source=(git+https://github.com/EgorSozonov/$pkgname#tag=$pkgver)
options=(!strip)
sha256sums=('SKIP')
changelog=changelog.txt

build() {
   make BIN="$srcdir/bin" PREFIX=/usr
}

check() {
   local exeVersion="$($srcdir/bin/$pkgname -v)"
   if [[ "$exeVersion" != "$pkgver" ]]; then
      error "The program has version $exeVersion but the package's version = $pkgver"
      exit 1
   fi
}

package() {
   make install BIN="$srcdir/bin" DESTDIR="$pkgdir" PREFIX=/usr
}

