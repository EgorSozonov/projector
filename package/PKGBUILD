# Maintainer: Egor Sozonov
# Contributor: Egor Sozonov

pkgname=projer
pkgver=_
pkgrel=1
pkgdesc='Project generation tool (from templates)' 
arch=(x86_64)
url='https://github.com/EgorSozonov/projector'
license=(BSD-3-Clause)
depends=() 
makedepends=(git musl)
source=(git+https://github.com/EgorSozonov/projector#tag=$pkgver)
options=(!debug !strip)
sha256sums=('SKIP')
changelog=changelog.txt

build() {
   echo "srcdir $srcdir"
   make BIN="$srcdir/bin" PREFIX=/usr
}

check() {
   local exeVersion="$($srcdir/bin/$pkgname -v)"
   if [[ "$exeVersion" != "$pkgver" ]]; then
      error "The program has version $exeVersion but the package's version = $pkgver"
      exit 1
   fi
}

package() {
   make install OBJDIR="$pkgdir" DESTDIR="$pkgdir" #-D bin/$pkgname "$pkgdir/usr/bin/$pkgname"
}

