#!/usr/bin/make -f

.RECIPEPREFIX = /

### main packaging script based on post dh7 syntax
%:
/ dh $@

override_dh_auto_build:
/ make all

override_dh_auto_install:
/ DESTDIR=$(TEMP)/a/debian/$(APP) make install

override_dh_builddeb:
/ dpkg-deb -b "$(TEMP)/a/debian/$(APP)" $(TEMP)/$(APP)_$(VERSION)_amd64.deb

override_dh_install:

