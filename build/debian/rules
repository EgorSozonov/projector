#!/usr/bin/make -f

.RECIPEPREFIX = /

### main packaging script based on post dh7 syntax
%:
/ dh $@ --builddirectory=$(TEMP)

override_dh_auto_build:
/ make all

override_dh_auto_install:
#/ dh_auto_install --destdir=$(TEMP)/debian/$(APP)/$(PREFIX)/bin
/ make install

override_dh_builddeb:
/ chmod 755 $(TEMP)/debian
/ chmod 755 $(TEMP)/debian/$(APP)
/ chmod 755 $(TEMP)/debian/$(APP)/DEBIAN
/ dpkg-deb -b "$(TEMP)/debian/$(APP)" $(TEMP)/$(APP)_$(VERSION)_amd64.deb

override_dh_install:

