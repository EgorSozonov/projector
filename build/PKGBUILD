pkgbase=projector
pkgname=(projector)
pkgver=_
pkgrel=1
pkgdesc='Project generation tool' 
arch=(x86_64)
url='https://github.com/EgorSozonov/projector'
license=(BSD-3-Clause)
depends=() 
makedepends=(git musl)
source=(git+https://github.com/EgorSozonov/projector#tag=$pkgver)
options=(!debug !strip)
